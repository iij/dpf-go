#!/bin/sh
# SPDX-License-Identifier: Apache-2.0
#
# コミット前に、ステージした変更だけをシークレット検査する。
#
# 有効化:   make install-hooks
# 無効化:   make uninstall-hooks
# 一時回避: git commit --no-verify
#
# ここで見るのはステージ内容のみ。--no-verify や rebase, cherry-pick で
# この hook を通らないコミットも入りうるため、pre-push で履歴側も見る。

set -eu

# git worktree や GIT_WORK_TREE 経由でも作業ツリーの最上位で走らせる。
# 設定ファイル .gitleaks.toml と .gitleaksignore はそこにある。
cd "$(git rev-parse --show-toplevel)"

if ! command -v gitleaks >/dev/null 2>&1; then
	cat >&2 <<'EOF'
gitleaks が見つからないため、シークレット検査ができない。
検査せずに通すと hook の意味が無くなるので、コミットを中断する。

  導入: https://github.com/gitleaks/gitleaks#installing
        （CI と同じ v8 系を使うこと。make gitleaks で同じ検査が走る）
  回避: git commit --no-verify
EOF
	exit 1
fi

# --staged はステージされた差分のみを走査する（git diff --cached 相当）。
#
# --redact を必ず付ける。付けないと検出したシークレットそのものが端末に
# 出て、スクロールバッファや CI のログに残り、被害を広げてしまう。
#
# --verbose は付ける。付けないと「leaks found: 1」しか出ず、どのファイルの
# 何行目が引っかかったのか分からない。出力先が本人の端末だけなので、
# ファイル・行・ルール ID を出しても差し支えない（CI では付けない）。
exec gitleaks git . --staged --redact --verbose --no-banner --exit-code 1
